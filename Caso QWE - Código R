# 1. LIBRERIAS Y DATOS
library(dplyr)
library(ggplot2)


# Usar los datos preparados por las compañeras
if (!exists("datos_limpios")) {
  stop("Primero ejecuta las partes 1 y 2.")
}


# Preparar las variables del modelo
# Se usa casos_mes0 y no prioridad para evitar
# la correlacion alta entre ambas variables.


datos_modelo <- datos_limpios %>%
  mutate(
    churn = as.numeric(as.character(churn)),
   
    grupo_edad = cut(
      edad_meses,
      breaks = c(-Inf, 5, 14, Inf),
      labels = c("Menos de 6 meses",
                 "6 a 14 meses",
                 "Mas de 14 meses")
    ),
   
    # Identificar CHI igual a cero
    chi_cero = ifelse(chi_mes0 == 0, 1, 0),
   
    # Reducir el efecto de valores extremos
    vistas_transformadas = asinh(vistas_cambio)
  ) %>%
  select(
    id, churn, grupo_edad,
    chi_mes0, chi_cero, chi_cambio,
    casos_mes0, logins_cambio,
    blogs_cambio, vistas_transformadas,
    dias_ultimo_login_cambio
  ) %>%
  filter(complete.cases(.))


# Verificar los datos
print(table(datos_modelo$churn))
print(nrow(datos_modelo))


if (!all(datos_modelo$churn %in% c(0, 1))) {
  stop("Churn debe contener solamente 0 y 1.")
}


if (length(unique(datos_modelo$churn)) != 2) {
  stop("Se necesitan las dos clases de churn.")
}


# 2. DIVISION DE ENTRENAMIENTO Y PRUEBA
set.seed(123)


# Separar indices de clientes segun Churn
indices <- split(
  seq_len(nrow(datos_modelo)),
  datos_modelo$churn
)


# Seleccionar 70% de cada grupo
indices_train <- unlist(
  lapply(indices, function(x) {
    if (length(x) < 2) {
      stop("Cada clase debe tener al menos 2 clientes.")
    }
    n <- max(1, min(floor(length(x) * 0.70),
                    length(x) - 1))
    sample(x, n)
  }),
  use.names = FALSE
)


entrenamiento_p3 <- datos_modelo[indices_train, ]
prueba_p3 <- datos_modelo[-indices_train, ]


cat("Clientes entrenamiento:",
    nrow(entrenamiento_p3), "\n")


cat("Clientes prueba:",
    nrow(prueba_p3), "\n")


# 3. MODELO DE REGRESION LOGISTICA
# Variables seleccionadas segun el analisis anterior
formula_p3 <- churn ~ grupo_edad +
  chi_mes0 + chi_cero + chi_cambio +
  casos_mes0 + logins_cambio +
  blogs_cambio + vistas_transformadas +
  dias_ultimo_login_cambio


modelo_logistico_p3 <- glm(
  formula_p3,
  data = entrenamiento_p3,
  family = binomial(link = "logit")
)


# Resumen del modelo
print(summary(modelo_logistico_p3))


# 4. EVALUACION DEL MODELO
# Probabilidades en los datos de prueba
prob_prueba_p3 <- predict(
  modelo_logistico_p3,
  newdata = prueba_p3,
  type = "response"
)


# Se usa umbral de 0.50 inicialmente
umbral_p3 <- 0.50


pred_prueba_p3 <- ifelse(
  prob_prueba_p3 >= umbral_p3, 1, 0
)


# Matriz de confusion
matriz_confusion_p3 <- table(
  Real = factor(prueba_p3$churn,
                levels = c(0, 1)),
  Predicho = factor(pred_prueba_p3,
                    levels = c(0, 1))
)


print(matriz_confusion_p3)


# Valores de la matriz
TN <- matriz_confusion_p3["0", "0"]
FP <- matriz_confusion_p3["0", "1"]
FN <- matriz_confusion_p3["1", "0"]
TP <- matriz_confusion_p3["1", "1"]


# Metricas
accuracy_p3 <- (TP + TN) /
  sum(matriz_confusion_p3)


sensibilidad_p3 <- if ((TP + FN) > 0) {
  TP / (TP + FN)
} else {
  NA_real_
}


especificidad_p3 <- if ((TN + FP) > 0) {
  TN / (TN + FP)
} else {
  NA_real_
}


metricas_p3 <- data.frame(
  Metrica = c("Accuracy",
              "Sensibilidad",
              "Especificidad"),
  Porcentaje = round(
    c(accuracy_p3,
      sensibilidad_p3,
      especificidad_p3) * 100, 2
  )
)


print(metricas_p3)


# 5. PROBABILIDAD DE ABANDONO DE CADA CLIENTE
# Aplicar el modelo a todos los clientes
prob_clientes_p3 <- predict(
  modelo_logistico_p3,
  newdata = datos_modelo,
  type = "response"
)


ranking_clientes_p3 <- data.frame(
  id = datos_modelo$id,
  probabilidad_churn = prob_clientes_p3
)


# Organizar de mayor a menor probabilidad
ranking_clientes_p3 <- ranking_clientes_p3 %>%
  arrange(desc(probabilidad_churn)) %>%
  mutate(
    posicion = row_number(),
    probabilidad_porcentaje =
      round(probabilidad_churn * 100, 2)
  )


print(head(ranking_clientes_p3, 20))


# 6. TOP 100 CLIENTES CON MAYOR RIESGO
top_100_clientes_p3 <- head(
  ranking_clientes_p3, 100
)


print(top_100_clientes_p3)


# Guardar ranking completo
write.csv(
  ranking_clientes_p3,
  "ranking_completo_churn.csv",
  row.names = FALSE
)


# Guardar los 100 clientes
write.csv(
  top_100_clientes_p3,
  "top_100_clientes_churn.csv",
  row.names = FALSE
)


# 7. TRES FACTORES MAS IMPORTANTES
# Prueba de contribucion de cada variable
importancia_p3 <- drop1(
  modelo_logistico_p3,
  test = "Chisq"
)


importancia_p3 <- as.data.frame(importancia_p3)


importancia_p3$factor <- rownames(importancia_p3)


# Excluir referencia del modelo completo
importancia_p3 <- importancia_p3 %>%
  filter(factor != "<none>") %>%
  arrange(desc(LRT))


# Seleccionar los tres factores principales
top_3_factores_p3 <- head(importancia_p3, 3)


print(top_3_factores_p3)


# Guardar factores
write.csv(
  importancia_p3,
  "importancia_factores_churn.csv",
  row.names = FALSE
)


