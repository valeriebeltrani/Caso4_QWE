# Función auxiliar: tasa de churn por grupo
tasa_por <- function(df, var) {
  df %>%
    group_by({{ var }}) %>%
    summarise(clientes = n(),
              se_fueron = sum(churn),
              tasa_churn_pct = round(100 * mean(churn), 1),
              .groups = "drop")
}


